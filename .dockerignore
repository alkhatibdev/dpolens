# What an image never needs, and what it must not carry.
#
# A credential or a local database copy in the build context ends up in the
# image, and an image is pushed to places a working directory never goes.

.env
.env.*
!.env.example

.git/
.github/
.venv/
**/__pycache__/
**/*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*

# Tests, evaluation runs and planning material are not part of a running
# instance. The tests run in CI and on a contributor's machine, where the
# repository itself is available.
tests/
evals/runs/
dashboard/node_modules/
dist/
build/
*.egg-info/

# The documentation, the client configurations and the deployment files are read
# where the repository is, not from inside a container.
docs/
clients/
*.md
!packs/**/*.md
