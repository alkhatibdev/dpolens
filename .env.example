# Copy this to .env and put a generated value on each line. One command does it:
#
#   printf 'DPOLENS_OWNER_PASSWORD=%s\nDPOLENS_APP_PASSWORD=%s\n' \
#     "$(openssl rand -hex 24)" "$(openssl rand -hex 24)" > .env
#
# There are two database roles, so there are two passwords. One role owns the
# tables. The other is the one the API connects as, and it holds no UPDATE or
# DELETE on the governance log, which is what makes that log append only.

DPOLENS_OWNER_PASSWORD=
DPOLENS_APP_PASSWORD=

# Where the instance is published on the machine running it. The MCP server's
# URL for an editor is http://localhost:8765/mcp.
# DPOLENS_API_PORT=8000
# DPOLENS_MCP_PORT=8765

# Host headers the MCP server answers, as a JSON list. Empty means loopback
# only, which is right when every developer runs their own instance. A shared
# instance names itself here, for example ["dpolens.example.com:8765"].
# DPOLENS_MCP_ALLOWED_HOSTS=[]
