                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "title",
          "kind",
          "version_label",
          "effective_date",
          "clauses",
          "languages",
          "pack_slug",
          "jurisdiction",
          "trust_tier",
          "source_url"
        ],
        "title": "Document"
      },
      "DocumentInDetail": {
        "properties": {
          "document": {
            "$ref": "#/components/schemas/Document"
          },
          "outline": {
            "items": {
              "$ref": "#/components/schemas/OutlineEntry"
            },
            "type": "array",
            "title": "Outline",
            "description": "The top level only, without text. Read further with a clause key"
          }
        },
        "type": "object",
        "required": [
          "document",
          "outline"
        ],
        "title": "DocumentInDetail"
      },
      "Documents": {
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/Document"
            },
            "type": "array",
            "title": "Documents"
          },
          "total": {
            "type": "integer",
            "title": "Total",
            "description": "How many documents are in force, ignoring limit and offset"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "documents",
          "total",
          "limit",
          "offset"
        ],
        "title": "Documents"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Introspection": {
        "properties": {
          "active": {
            "type": "boolean",
            "title": "Active"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "pat_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pat Id"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Permissions"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "active"
        ],
        "title": "Introspection",
        "description": "Who a token belongs to, and what it may do right now.\n\n`active` is false for anything that cannot be used, whether it is unknown,\nrevoked, expired or owned by somebody who has left. A surface only needs to\nknow that it cannot act; the API decides what it may do on the call itself."
      },
      "IntrospectionRequest": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token",
            "description": "The token presented by the caller being asked about"
          }
        },
        "type": "object",
        "required": [
          "token"
        ],
        "title": "IntrospectionRequest"
      },
      "OutlineEntry": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "clause_type": {
            "type": "string",
            "title": "Clause Type"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "heading": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heading"
          },
          "is_normative": {
            "type": "boolean",
            "title": "Is Normative"
          },
          "children": {
            "type": "integer",
            "title": "Children",
            "description": "How many clauses sit directly beneath this one"
          }
        },
        "type": "object",
        "required": [
          "key",
          "clause_type",
          "label",
          "heading",
          "is_normative",
          "children"
        ],
        "title": "OutlineEntry",
        "description": "What a top-level clause is, without what it says.\n\nThe text is absent on purpose: an outline that carried it would return whole\ndocuments for anything whose top level holds real text, such as recitals.\nRead the words with the clause routes."
      },
      "ProblemDocument": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Stable identifier for this kind of failure"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "instance": {
            "type": "string",
            "title": "Instance",
            "description": "The path that produced it"
          }
        },
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance"
        ],
        "title": "ProblemDocument",
        "description": "The error shape, declared so the specification carries it.\n\nA client branches on `type`. `title` and `status` say what class of failure it\nis, and `detail` is written for whoever has to fix it. Some problems add a\nfield of their own, such as the permission a token is missing."
      },
      "Result": {
        "properties": {
          "clause": {
            "$ref": "#/components/schemas/Clause"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "breadcrumb": {
            "items": {
              "$ref": "#/components/schemas/Clause"
            },
            "type": "array",
            "title": "Breadcrumb",
            "description": "Where the clause sits, outermost first"
          },
          "cross_references": {
            "items": {
              "$ref": "#/components/schemas/CrossReference"
            },
            "type": "array",
            "title": "Cross References"
          },
          "expanded": {
            "items": {
              "$ref": "#/components/schemas/Clause"
            },
            "type": "array",
            "title": "Expanded",
            "description": "Siblings or the parent, when the request asked"
          },
          "ranks": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "integer"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ranks",
            "description": "Where each retriever placed this clause, when the request asked to explain. A debugging aid whose meaning changes when the fusion rule does"
          }
        },
        "type": "object",
        "required": [
          "clause",
          "score",
          "breadcrumb",
          "cross_references"
        ],
        "title": "Result"
      },
      "Results": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/Result"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "results"
        ],
        "title": "Results"
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Query",
            "description": "The question, in words"
          },
          "limit": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 10
          },
          "lang": {
            "type": "string",
            "maxLength": 20,
            "title": "Lang",
            "default": "en"
          },
          "expand": {
            "type": "string",
            "enum": [
              "none",
              "siblings",
              "parent"
            ],
            "title": "Expand",
            "description": "Also return the siblings, or the parent, of each hit",
            "default": "none"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of",
            "description": "Read the corpus as it stood on this date, to cite what was in force then"
          },
          "include_explanatory": {
            "type": "boolean",
            "title": "Include Explanatory",
            "description": "Include text that explains without obliging, such as a recital. Off by default, because such text reads more like a question than the article that creates the duty",
            "default": false
          },
          "explain": {
            "type": "boolean",
            "title": "Explain",
            "description": "Include each retriever's ranking, for debugging",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
