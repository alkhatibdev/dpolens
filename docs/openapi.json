  "components": {
    "schemas": {
      "Clause": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key",
            "description": "The canonical key a citation points at"
          },
          "clause_type": {
            "type": "string",
            "title": "Clause Type"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label",
            "description": "The numbering the law itself uses, such as 1. or (a)"
          },
          "heading": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heading"
          },
          "text": {
            "type": "string",
            "title": "Text",
            "description": "The clause as it stands, verbatim"
          },
          "lang": {
            "type": "string",
            "title": "Lang"
          },
          "is_authoritative": {
            "type": "boolean",
            "title": "Is Authoritative",
            "description": "Whether this language is the one that prevails in law"
          },
          "is_normative": {
            "type": "boolean",
            "title": "Is Normative",
            "description": "False for text that explains without obliging, such as a recital"
          },
          "depth": {
            "type": "integer",
            "title": "Depth"
          },
          "document_title": {
            "type": "string",
            "title": "Document Title"
          },
          "document_slug": {
            "type": "string",
            "title": "Document Slug"
          },
          "version_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version Label"
          },
          "effective_date": {
            "type": "string",
            "format": "date",
            "title": "Effective Date"
          },
          "pack_slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pack Slug",
            "description": "Null for an organisation's own policy"
          },
          "jurisdiction": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jurisdiction"
          },
          "trust_tier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trust Tier",
            "description": "verified when a named maintainer checked the pack against the official source, community when it has passed validation only, null for a policy"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          }
        },
        "type": "object",
        "required": [
          "key",
          "clause_type",
          "label",
          "heading",
          "text",
          "lang",
          "is_authoritative",
          "is_normative",
          "depth",
          "document_title",
          "document_slug",
          "version_label",
          "effective_date",
          "pack_slug",
          "jurisdiction",
          "trust_tier",
          "source_url"
        ],
        "title": "Clause"
      },
      "ClauseInContext": {
        "properties": {
          "clause": {
            "$ref": "#/components/schemas/Clause"
          },
          "breadcrumb": {
            "items": {
              "$ref": "#/components/schemas/Clause"
            },
            "type": "array",
            "title": "Breadcrumb"
          },
          "children": {
