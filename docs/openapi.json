{
  "openapi": "3.1.0",
  "info": {
    "title": "DPOLens",
    "summary": "Policies and law, with citations a client can check",
    "description": "\nThe only way into DPOLens. Every surface, including the MCP server and the\ndashboard, is a client of this API.\n\nInterfaces change without notice until 1.0. Errors are\n[RFC 9457](https://www.rfc-editor.org/info/rfc9457/) problem details, and `type`\nis the field to branch on.\n",
    "version": "0.0.0"
  },
  "paths": {
    "/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Is the process running",
        "operationId": "live_live_get",
